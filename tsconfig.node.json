{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["*.config.ts", "security-headers.ts", "*.test.ts", "e2e/**/*.ts"]
}
